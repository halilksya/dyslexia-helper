<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers> 
    <Nullable>enable</Nullable>
    <ApplicationId>com.CompanyName.DyslexiaHelper</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="RapidOcrNet" GeneratePathProperty="true" /> 
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DyslexiaHelper\DyslexiaHelper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="$(PkgRapidOcrNet)/models/v5/*" Link="Assets/models/v5/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
